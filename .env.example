# Salin file ini menjadi .env dan isi nilainya
# JANGAN upload file .env ke GitHub!

# Token dari @BotFather di Telegram
BOT_TOKEN=your_telegram_bot_token_here

# Telegram User ID Anda (cari lewat @userinfobot di Telegram)
ALLOWED_USER_ID=your_telegram_user_id_here

# Timezone (jangan diubah jika di Papua)
TIMEZONE=Asia/Jayapura

# Path database SQLite (di Railway gunakan /data/reports.db)
DATABASE_PATH=reports.db

# Folder untuk simpan foto (di Railway gunakan /data/photos)
PHOTO_DIR=outputs/photos
